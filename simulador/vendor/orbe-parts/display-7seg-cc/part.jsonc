    "digit": { "of": "segments", "above": { "value": 0.0002, "unit": "A", "source": { "datasheet": { "doc": "TOPLITE A-5161AS, 0.56 inch single digit super red display", "at": "The luminous-intensity figure rises from 0 mA in step with the current, so 0.2 mA gives about a fiftieth of the intensity rated at 10 mA: a dim bar, plain to see on the dark face. Below it the current is within ten times the 20 uA reverse leakage.", "basis": "typical" } } } }
  },
  "view": {
    "glow": [{ "node": "seg-a", "by": "seg_a" }, { "node": "seg-b", "by": "seg_b" }, { "node": "seg-c", "by": "seg_c" }, { "node": "seg-d", "by": "seg_d" }, { "node": "seg-e", "by": "seg_e" }, { "node": "seg-f", "by": "seg_f" }, { "node": "seg-g", "by": "seg_g" }, { "node": "seg-dp", "by": "seg_dp" }]
  },
  "not_simulated": [
    { "what": "light", "why": "The engine reports each segment's current, not luminous intensity. The drawing scales current by 10 mA, the current where Iv is rated, so a segment's glow is 1 at 10 mA and blooms above that. The candela at that current is not modeled. The forward curve is the figure's, fitted from 2 mA to 20 mA as its source names. The electrical table lists 2.1 V typical at 20 mA; the figure reads about 1.94 V there, and the fit follows the figure. Below 2 mA and above 20 mA the current is that curve extended." },
    { "what": "temperature", "why": "The fits are at 25 C and the engine has no temperature." },
    { "what": "reverse breakdown", "why": "The engine's LED has no breakdown voltage. The sheet rates 5 V reverse per segment." },
    { "what": "the digit", "why": "digit reads the segments a to g a viewer sees glow, each above 0.2 mA. It is 0 to 9 when that pattern is one digit, also 6 without its top bar, 9 without its bottom bar and 7 with f, blank when none of them glows, and otherwise the glowing letters. The decimal point does not change the digit. A pattern starts when the drive changes to one not seen in the last 20 ms, so a new digit reads within 1 ms and the old one never mixes in. PWM or multiplexing at 100 Hz or faster repeats its patterns within 20 ms, so its digit holds through each dark part of the cycle. Below about 100 Hz a real digit flickers, and the reading can show the dark part." }
  ]
}
