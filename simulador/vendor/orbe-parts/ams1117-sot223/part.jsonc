      "power": {
        "value": 1.1111111111111112,
        "unit": "W",
        "basis": { "sustained": { "average": "mean", "tau": { "value": 0.0102, "unit": "s", "source": { "closed_form": { "note": "The sheet gives no pulse rating to fit, so this is the 10.2 ms default, five periods of a 490 Hz PWM." } } } } },
        "source": {
          "closed_form": {
            "note": "(125 C - 25 C) / 90 C/W. 125 C is the operating junction maximum and 90 C/W is the SOT-223 junction-to-ambient thermal resistance. Note 2 guarantees line and load regulation up to 1.2 W for the SOT-223."
          }
        }
      },
      "input_voltage": { "value": 15, "unit": "V", "source": { "datasheet": { "doc": "AMS1117 1A Low Dropout Voltage Regulator", "at": "ABSOLUTE MAXIMUM RATINGS, Input Voltage, 15 V", "basis": "absolute_max" } } },
    },
    "pins": { "in": "IN", "out": "OUT", "gnd": "GND" }
  },
  "not_simulated": [
    {
      "what": "dropout shape",
      "why": "The sheet's dropout is VIN minus VOUT when VOUT has fallen by 1 percent, one typical: 1.1 V at 0.8 A. The model holds that drop. The description says it decreases at lower load currents, and Note 4 says it is higher above 0.8 A. The sheet gives no second current, so the model does neither."
    },
    {
      "what": "ground current shape",
      "why": "Ground current stays at the 5 mA typical. The quiescent-current row has no load term."
    },
    {
      "what": "thermal shutdown and the input diode",
      "why": "The sheet shuts the regulator down on overtemperature, and an internal diode from the output to the input handles a short surge. The model has no shutdown and blocks reverse current. The power rating warns instead."
    }
  ]
}
