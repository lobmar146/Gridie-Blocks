  "real": { "maker": "Tower Pro", "number": "SG90", "datasheet": "Tower Pro SG90 Analog" },
  "pins": { "GND": [1], "VCC": [2], "SIGNAL": [3] },
  "model": {
    "kind": "sg90",
    "input_threshold": {
      "low": { "value": 0.3, "unit": "1", "source": { "closed_form": { "note": "The AA51880 sheet lists no VIN threshold. 0.3 of the supply is the low, under the high." } } },
      "high": { "value": 0.5, "unit": "1", "source": { "closed_form": { "note": "The AA51880 sheet lists no VIN threshold. ESP32 boards drive the signal from a 3.3 V GPIO while the motor runs from 5 V, as in the Last Minute Engineers and DroneBot Workshop ESP32 servo pages. 0.5 of the supply is 3.0 V at the 6 V sheet maximum and 2.5 V at 5 V, so a 3.3 V high clears it." } } }
    },
    "pins": { "VCC": "VCC", "GND": "GND", "SIGNAL": "SIGNAL" }
  },
