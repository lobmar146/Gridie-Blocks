    "horn": { "node": "horn", "turn": [0, 0, -1], "range": { "value": 180, "unit": "deg" }, "by": "angle" }
  },
  "not_simulated": [
    { "what": "load and stall", "why": "Nothing pushes on the shaft, so the 1.8 kg·cm stall torque and the 520 mA stall current from the sheets are not states. The current is 140 mA while the shaft is moving and 5 mA while it holds." },
    { "what": "speed off the two cited points", "why": "Tower Pro and Luxorparts state 0.12 s per 60° at 4.8 V. Luxorparts states 0.10 s per 60° at 6 V. Between 4.8 V and 6 V the speed is the straight line through those two figures. Below 4.8 V, down to 3.0 V, no slower figure is cited, so the speed is the 4.8 V figure times the supply over 4.8 V. Below 4.5 V the part warns supply. 4.5 V is the low end of the range the Nano's 5 V pin can read, so that pin does not warn. At 6 V and above it holds the 6 V speed." },
    { "what": "supply below 3.0 V", "why": "The AA51880 sheet lists no operating supply range, no UVLO and no restart level. Its 2.3 V is VREG minimum, the regulator output at Vcc 4.8 V. 4tronix lists an SG90 operating voltage of 3.0 V to 7.2 V, the lowest such minimum among the cited sheets. Below 3.0 V the shaft stays put and the draw is none. Above 3.0 V it follows, including after a dip below 3.0 V. When the 140 mA moving draw itself pulls the supply under 3.0 V, the shaft holds and the part warns that the supply sags under the moving draw. A real SG90 browns out and jitters there, because the controller resets and tries again. The model holds the shaft instead of buzzing, and the draw returns to the 5 mA hold as soon as the rail recovers." }
  ]
}
