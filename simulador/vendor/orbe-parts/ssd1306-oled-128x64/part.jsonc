  "pins": {
    "VSS": [1, 8, 29, 30], "C2P": [2], "C2N": [3], "C1P": [4], "C1N": [5], "VBAT": [6], "NC": [7], "VDD": [9],
    "BS0": [10], "BS1": [11], "BS2": [12], "CS": [13], "RES": [14], "SA0": [15], "RW": [16], "ERD": [17],
    "SCL": [18], "SDA": [19, 20], "D3": [21], "D4": [22], "D5": [23], "D6": [24], "D7": [25],
    "IREF": [26], "VCOMH": [27], "VCC": [28],
  },
  "model": {
    "kind": "ssd1306",
    "address": 60,
    "low_drop": { "value": 0.0, "unit": "V", "source": { "closed_form": { "note": "an open drain pulls SDA to VSS through its resistance alone" } } },
    "low_resistance": { "value": 133.33333333333334, "unit": "ohm", "source": { "closed_form": { "note": "UM10204 Rev. 7.0 Table 9, VOL1 0.4 V at 3 mA for a Fast-mode device, so 0.4 V / 3 mA. SSD1306 Table 12-1 gives VOL only at 100 uA" } } },
    "input_threshold": {
      "low": { "value": 0.2, "unit": "1", "source": { "datasheet": { "doc": "Solomon Systech SSD1306 Rev 1.1", "at": "Table 12-1, VIL 0.2 VDD maximum", "basis": "max" } } },
      "high": { "value": 0.8, "unit": "1", "source": { "datasheet": { "doc": "Solomon Systech SSD1306 Rev 1.1", "at": "Table 12-1, VIH 0.8 VDD minimum", "basis": "min" } } },
    },
    // The panel's logic and charge pump draw together from VDD, as the modules tie VBAT to VDD.
    "draw": {
      "sleep_current": { "value": 1e-6, "unit": "A", "source": { "datasheet": { "doc": "Univision UG-2864HSWEG01", "at": "section 3.2, sleep mode current for VDD, IDD,SLEEP 1 uA typical, with the display off", "basis": "typical" } } },
      "logic_current": { "value": 1.8e-4, "unit": "A", "source": { "datasheet": { "doc": "Univision UG-2864HSWEG01", "at": "section 3.2, operating current for VDD, IDD 180 uA typical", "basis": "typical" } } },
      "half_lit_current": { "value": 0.0173, "unit": "A", "source": { "datasheet": { "doc": "Univision UG-2864HSWEG01", "at": "section 3.2 note 7, operating current for VBAT with the internal DC/DC, 17.3 mA typical with 50% of the display area on", "basis": "typical" } } },
      "all_lit_current": { "value": 0.0231, "unit": "A", "source": { "datasheet": { "doc": "Univision UG-2864HSWEG01", "at": "section 3.2 note 8, operating current for VBAT with the internal DC/DC, 23.1 mA typical with 100% of the display area on", "basis": "typical" } } },
      "holds_above": { "value": 1.65, "unit": "V", "source": { "datasheet": { "doc": "Univision UG-2864HSWEG01", "at": "section 3.2, supply voltage for logic VDD 1.65 V minimum", "basis": "min" } } },
    },
    "ratings": {
      "rail_margin": { "value": 0.3, "unit": "V", "source": { "datasheet": { "doc": "Solomon Systech SSD1306 Rev 1.1", "at": "Table 11-1, Maximum Ratings (Voltage Referenced to VSS), p. 47: Vin Input voltage VSS - 0.3 to VDD + 0.3 V, and VDD min -0.3 V", "basis": "absolute_max" } } },
      "supply_voltage": { "value": 4.0, "unit": "V", "source": { "datasheet": { "doc": "Solomon Systech SSD1306 Rev 1.1", "at": "Table 11-1, Maximum Ratings (Voltage Referenced to VSS), p. 47: VDD Supply Voltage -0.3 to +4 V (also Univision UG-2864HSWEG01 section 2, p. 7)", "basis": "absolute_max" } } },
    },
    "pins": { "VDD": "VDD", "VSS": "VSS", "SCL": "SCL", "SDA": "SDA", "RES": "RES" },
