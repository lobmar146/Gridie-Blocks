  "model": {
    "kind": "pmos",
    "transconductance_parameter": {
      "value": 4.579,
      "unit": "A/V^2",
      "source": {
        "datasheet": {
          "doc": "onsemi FDN340P/D, Rev. 9, May 2025",
          "at": "On Characteristics, RDS(on) typical 60 mΩ at VGS = -4.5 V, ID = -2 A. |vds| is 0.12 V there. With VTO = 0.8 V, KP = 2 / (0.12 * (3.7 - 0.06)) rounds to 4.579 A/V^2 and gives 0.060 ohm at that point. At VGS = -2.5 V and ID = -1.7 A the model gives about 0.138 ohm, where the table's typical is 82 mΩ. In saturation at 2 A the model's gm is about 4.28 S, where gFS typical is 9 S",
          "basis": "typical",
        },
      },
    },
    "threshold_voltage": {
      "value": 0.8,
      "unit": "V",
      "source": {
        "datasheet": {
          "doc": "onsemi FDN340P/D, Rev. 9, May 2025",
          "at": "On Characteristics, VGS(th) typical -0.8 V at VDS = VGS, ID = -250 µA. The kind stores the magnitude. The table's range is -0.4 V to -1.5 V",
          "basis": "typical",
        },
      },
    },
    "channel_length_modulation": {
      "value": 0.0,
      "unit": "1/V",
      "source": {
        "datasheet": {
          "doc": "onsemi FDN340P/D, Rev. 9, May 2025",
          "at": "Not fitted. The on-resistance point is at |vds| = 0.12 V, in the linear region, so the output-curve slope was not read",
          "basis": "typical",
        },
      },
    },
    "gate_source_capacitance": {
      "value": 7.23e-10,
      "unit": "F",
      "source": {
        "datasheet": {
          "doc": "onsemi FDN340P/D, Rev. 9, May 2025",
          "at": "Capacitance, Ciss typical minus Crss typical, 779 pF minus 56 pF, VDS = -10 V, VGS = 0 V, f = 1 MHz",
          "basis": "typical",
        },
      },
    },
    "gate_drain_capacitance": {
