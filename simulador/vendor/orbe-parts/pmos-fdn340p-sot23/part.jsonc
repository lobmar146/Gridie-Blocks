  "not_simulated": [
    { "what": "body diode", "why": "The engine's pmos has none, so the part does not conduct from drain to source when the drain rises above the source. The datasheet's VSD is -0.7 V typical. Add a diode from drain to source if a circuit needs that path." },
    { "what": "drain and source resistance", "why": "The square law folds them in. At VGS = -2.5 V and ID = -1.7 A the model gives about 0.138 ohm, against the table's 82 mΩ typical." },
    { "what": "subthreshold conduction", "why": "Below 0.8 V of |Vgs| the drain passes only the engine's 1e-12 S leakage." },
    { "what": "voltage-dependent capacitances", "why": "The capacitances are the typical values at VDS = -10 V, held constant, so gate charge is approximate." },
    { "what": "breakdown", "why": "VDS beyond 20 V and VGS beyond 8 V are not checked." },
    { "what": "temperature", "why": "The fit is at 25 C and the engine has no temperature." },
  ],
}
