    "ratings": {
      "reverse_voltage": {
        "value": 1,
        "unit": "V",
        "source": {
          "datasheet": {
            "doc": "Nichicon, General Descriptions of Aluminum Electrolytic Capacitors",
            "at": "Section 2-3-2 Reverse Voltage: a cathode foil withstands about 1 V because of the natural oxide layer on its surface. A reverse voltage over that raises the internal pressure and opens the vent.",
            "basis": "absolute_max"
          }
        }
      }
    }
