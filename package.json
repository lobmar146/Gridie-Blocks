{
  "name": "gridieblocks",
  "private": true,
  "version": "1.0.0",
  "description": "A Blockly-based IDE for Arduino",
  "author": "Gridie",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:simulador": "cd simulador && npm install && npm run build",
    "servidor-compilacion": "node servidor-compilacion/servidor.mjs",
    "build": "npm run build:web",
    "build:electron": "electron-builder",
    "dist": "npm run build:web && npm run build:electron",
    "release": "npm run build:web && npm run build:electron --publish=always",
    "electron:build": "electron-builder",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@blockly/theme-dark": "^7.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-slot": "^1.1.0",
    "blockly": "^11.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.2",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/node": "^22.7.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.2.0",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "install": "^0.13.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.3.1",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "@swc/core@1.6.7": true,
    "electron@36.2.0": true,
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  }
}
