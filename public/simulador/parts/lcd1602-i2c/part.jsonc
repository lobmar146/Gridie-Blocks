  "format": 6,
  "part": "lcd1602-i2c",
  "version": "0.1.1",
  "title": "LCD display module, 16 x 2 blue, HD44780 + PCF8574 I2C",
  "summary": "Blue 16 x 2 character LCD module with a PCF8574 I2C backpack at address 0x27 and a 4-pin right-angle header. LiquidCrystal_I2C drives it.",
