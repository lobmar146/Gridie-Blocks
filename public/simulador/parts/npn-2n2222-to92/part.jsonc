  "docs": { "onsemi P2N2222A/D, Rev. 7": "https://www.onsemi.com/pdf/datasheet/p2n2222a-d.pdf" },
  "real": { "maker": "onsemi", "number": "P2N2222A", "datasheet": "onsemi P2N2222A/D, Rev. 7" },
  "pins": { "collector": [1], "base": [2], "emitter": [3] },
  "model": {
    "kind": "npn",
    "saturation_current": { "value": 4.572e-14, "unit": "A", "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "Figure 11, \"On\" Voltages, TJ = 25 C, VBE(on) at VCE = 1.0 V through (1 mA, 0.612 V) and (100 mA, 0.770 V), fitted by fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1", "basis": "typical" } } },
    "forward_beta": { "value": 218.8, "unit": "1", "source": { "closed_form": { "note": "173.2, the geometric mean of hFE minimum 100 and maximum 300 at IC = 150 mA and VCE = 10 V, onsemi P2N2222A/D Rev. 7 ON CHARACTERISTICS, times (1 + 0.15 A / forward_knee_current), so beta is 173.2 at 150 mA" } } },
    "forward_knee_current": { "value": 0.57, "unit": "A", "source": { "closed_form": { "note": "beta = forward_beta / (1 + IC / forward_knee_current) above the knee. onsemi P2N2222A/D Rev. 7 Figure 3, DC Current Gain, typical at VCE = 10 V and 25 C, falls from about 245 at 150 mA to 165 at 500 mA, and 0.57 A keeps that ratio" } } },
    "reverse_beta": { "value": 14.09, "unit": "1", "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "Figure 11, \"On\" Voltages, TJ = 25 C, VCE(sat) 0.017 V at IC = 1 mA, IC/IB = 10, fitted by fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1", "basis": "typical" } } },
    "forward_emission": { "value": 1.0, "unit": "1", "source": { "closed_form": { "note": "ideal junction" } } },
    "reverse_emission": { "value": 1.0, "unit": "1", "source": { "closed_form": { "note": "ideal junction" } } },
    "early_voltage": { "value": 100.0, "unit": "V", "source": { "closed_form": { "note": "puts hoe at 9.1 umhos at IC = 1 mA and VCE = 10 V, inside the 5 to 35 umhos of onsemi P2N2222A/D Rev. 7, whose table prints the unit as mMhos" } } },
    "base_resistance": { "value": 3.909, "unit": "ohm", "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "Figure 11, \"On\" Voltages, TJ = 25 C, VBE(sat) 0.832 V at IC = 100 mA, IC/IB = 10, fitted by fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1", "basis": "typical" } } },
    "collector_resistance": { "value": 0.1523, "unit": "ohm", "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "Figure 11, \"On\" Voltages, TJ = 25 C, VCE(sat) 0.073 V at IC = 100 mA, IC/IB = 10, fitted by fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1", "basis": "typical" } } },
    "emitter_resistance": { "value": 0.3756, "unit": "ohm", "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "Figure 11, \"On\" Voltages, TJ = 25 C, VBE(on) at VCE = 1.0 V through (1 mA, 0.612 V) and (100 mA, 0.770 V), fitted by fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1", "basis": "typical" } } },
    "base_emitter_capacitance": { "value": 2.5e-11, "unit": "F", "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "SMALL-SIGNAL CHARACTERISTICS, Cibo at VEB = 0.5 V, IC = 0, f = 1.0 MHz", "basis": "max" } } },
    "base_collector_capacitance": { "value": 8e-12, "unit": "F", "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "SMALL-SIGNAL CHARACTERISTICS, Cobo at VCB = 10 V, IE = 0, f = 1.0 MHz", "basis": "max" } } },
    "ratings": {
      "current": { "value": 0.6, "unit": "A", "basis": { "sustained": { "average": "rms", "tau": { "value": 0.0102, "unit": "s", "source": { "closed_form": { "note": "The sheet gives no pulse rating to fit, so this is the 10.2 ms default, five periods of a 490 Hz PWM." } } } } }, "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "MAXIMUM RATINGS, IC continuous, 600 mA", "basis": "absolute_max" } } },
      "power": { "value": 0.625, "unit": "W", "basis": { "sustained": { "average": "mean", "tau": { "value": 0.0102, "unit": "s", "source": { "closed_form": { "note": "The sheet gives no pulse rating to fit, so this is the 10.2 ms default, five periods of a 490 Hz PWM." } } } } }, "source": { "datasheet": { "doc": "onsemi P2N2222A/D, Rev. 7", "at": "MAXIMUM RATINGS, PD at TA = 25 C, 625 mW", "basis": "absolute_max" } } },
    },
  },
  "not_simulated": [
    { "what": "low-current beta", "why": "Beta falls at high current but not at low current, so below about 1 mA the model needs less base current than a real part." },
    { "what": "switching times", "why": "The capacitances are constant and there is no transit time, so a saturated switch has no storage time." },
    { "what": "breakdown", "why": "The junctions do not break down. VCEO (40 V) and VEBO (6 V) are not checked." },
    { "what": "temperature", "why": "The fit is at 25 C and the engine has no temperature." },
  ],
}
