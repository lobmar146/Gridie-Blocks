  "not_simulated": [
    { "what": "body diode", "why": "The engine's nmos has none, so the part does not conduct from source to drain. Add a diode there if a circuit needs that path." },
    { "what": "drain and source resistance", "why": "The square law folds them in. RDS(on) at a 10 V gate is 0.12 ohm here, against the table's 0.27 ohm maximum." },
    { "what": "subthreshold conduction", "why": "Below 3.18 V on the gate the drain passes only the engine's 1e-12 S leakage." },
    { "what": "voltage-dependent capacitances", "why": "The capacitances are the typical values at VDS = 25 V, held constant, so gate charge is approximate." },
