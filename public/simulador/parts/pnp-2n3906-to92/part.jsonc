  "not_simulated": [
    { "what": "beta roll-off", "why": "Beta does not fall at high or low current, so near 100 mA the model needs less base current than a real part." },
    { "what": "switching times", "why": "The capacitances are constant and there is no transit time, so a saturated switch has no storage time. The datasheet's storage time is 225 ns at most." },
    { "what": "breakdown", "why": "The junctions do not break down. VCEO (40 V) and VEBO (5 V) are not checked." },
    { "what": "temperature", "why": "The fit is at 25 C and the engine has no temperature." },
  ],
