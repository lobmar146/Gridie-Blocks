// Every color uses the red WP7113ID fit, the engine's values from
// packages/engine/tests/circuits/led-5v/netlist.json, as the engine's board example does for its L and ON LEDs.
{
  "format": 5, "part": "led-0603", "version": "0.2.1", "title": "LED, 0603 chip", "license": "MIT OR Apache-2.0",
  "summary": "0603 chip LED, 1.6 x 0.8 mm. Lead 1 is the anode and lead 2 the cathode. Pick its color.",
  "tags": ["led", "light", "indicator", "smd"],
  "docs": {
    "Kingbright APT1608SURCK, Spec No DSAD0926, Rev V.22A": "https://www.kingbrightusa.com/images/catalog/SPEC/APT1608SURCK.pdf",
    "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A": "https://www.kingbrightusa.com/images/catalog/SPEC/WP7113ID.pdf",
  },
  "real": { "generic": true, "maker": "Kingbright", "number": "APT1608", "datasheet": "Kingbright APT1608SURCK, Spec No DSAD0926, Rev V.22A" },
  "pins": { "anode": [1], "cathode": [2] },
  "params": {
    "color": {
      "required": true,
      "example": "red",
      "choices": {
        "red": {
          "tint": "#e0b0a4",
          "sets": {
            "/saturation_current": { "value": 6.711e-10, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K", "basis": "typical" } } },
            "/emission_coefficient": { "value": 4.427, "unit": "1", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K", "basis": "typical" } } },
            "/series_resistance": { "value": 2.115, "unit": "ohm", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K", "basis": "typical" } } },
          },
        },
        "yellow": {
          "tint": "#e8c56a",
          "sets": {
            "/saturation_current": { "value": 6.711e-10, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K. Stands in for a yellow LED, which has no fit of its own.", "basis": "typical" } } },
            "/emission_coefficient": { "value": 4.427, "unit": "1", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K. Stands in for a yellow LED, which has no fit of its own.", "basis": "typical" } } },
            "/series_resistance": { "value": 2.115, "unit": "ohm", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K. Stands in for a yellow LED, which has no fit of its own.", "basis": "typical" } } },
          },
        },
        "green": {
          "tint": "#c5d6b0",
          "sets": {
            "/saturation_current": { "value": 6.711e-10, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K. Stands in for a green LED, which has no fit of its own.", "basis": "typical" } } },
            "/emission_coefficient": { "value": 4.427, "unit": "1", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K. Stands in for a green LED, which has no fit of its own.", "basis": "typical" } } },
            "/series_resistance": { "value": 2.115, "unit": "ohm", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, Ta = 25 C; fit through (1.70 V, 2 mA), (1.90 V, 10 mA), (2.00 V, 20 mA) at kT/q for 298.15 K. Stands in for a green LED, which has no fit of its own.", "basis": "typical" } } },
          },
        },
      },
    },
  },
  "model": {
    "kind": "led",
    "ratings": {
      "current": { "value": 0.03, "unit": "A", "basis": { "sustained": { "average": "mean", "tau": { "value": 0.001, "unit": "s", "source": { "closed_form": { "note": "The sheet's peak forward current, 185 mA at 1/10 duty and 0.1 ms pulses, settles at 185 mA x (1 - e^-0.1) / (1 - e^-1) on a 1 ms mean, under the 30 mA DC rating." } } }, "peak": { "value": 0.185, "unit": "A", "source": { "datasheet": { "doc": "Kingbright APT1608SURCK, Spec No DSAD0926, Rev V.22A", "at": "Absolute Maximum Ratings at Ta = 25 C, peak forward current, 1/10 duty and 0.1 ms pulse width", "basis": "absolute_max" } } } } }, "source": { "datasheet": { "doc": "Kingbright APT1608SURCK, Spec No DSAD0926, Rev V.22A", "at": "Absolute Maximum Ratings at Ta = 25 C, DC forward current", "basis": "absolute_max" } } },
      "power": { "value": 0.075, "unit": "W", "basis": { "sustained": { "average": "mean", "tau": { "value": 0.0102, "unit": "s", "source": { "closed_form": { "note": "The sheet gives no pulse rating for power, so this is the 10.2 ms default, five periods of a 490 Hz PWM." } } } } }, "source": { "datasheet": { "doc": "Kingbright APT1608SURCK, Spec No DSAD0926, Rev V.22A", "at": "Absolute Maximum Ratings at Ta = 25 C, power dissipation", "basis": "absolute_max" } } },
    },
  },
  "readings": {
    "lit": { "of": "i", "above": { "value": 0.002, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Fig. Forward Current vs. Forward Voltage, the lowest fitted point, 2 mA. Fig. Luminous Intensity vs. Forward Current is a straight line from 0 to 20 mA normalized at 10 mA, so 2 mA is 0.2 of that intensity.", "basis": "typical" } } } },
    "dim": { "of": "i", "above": { "value": 0.0001, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "1 percent of the 10 mA at which Iv is rated. Fig. Luminous Intensity vs. Forward Current is a straight line from 0 to 20 mA normalized at 10 mA, so 100 uA is 0.01 of that intensity. Reverse current is 10 uA max at VR = 5 V, so the floor is ten times that leakage.", "basis": "typical" } } } },
    "brightness": { "of": "i", "full": { "value": 0.01, "unit": "A", "source": { "datasheet": { "doc": "Kingbright WP7113ID, Spec No DSAF0012, Rev V.14A", "at": "Electrical / Optical Characteristics, Iv rated at IF = 10 mA", "basis": "nominal" } } } },
  },
  "view": { "glow": [{ "node": "body", "by": "brightness" }], "tint": [{ "node": "body", "by": "color" }] },
  "not_simulated": [
    { "what": "yellow and green", "why": "They use the red WP7113ID fit until a fit of their own exists. That fit runs from 2 mA to 20 mA. Below 2 mA and above 20 mA the current is that curve extended. lit and dim follow that stand-in." },
    { "what": "light", "why": "The engine reports current, not luminous intensity. The drawing scales current by 10 mA. A threshold at 1 mA would sit outside the fit. Luminous intensity versus forward current is drawn as a straight line from 0 mA, so the extended current still glows in proportion." }
  ],
}
