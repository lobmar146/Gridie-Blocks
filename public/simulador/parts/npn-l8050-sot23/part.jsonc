      "value": 1.14e-11,
      "unit": "F",
      "source": {
        "datasheet": {
          "doc": "Leshan Radio L8050QLT1G Rev.D Jun. 2023",
          "at": "Page 4, Cobo at f = 1 MHz, read as 11.4 pF at VR = 1 V",
          "basis": "typical"
