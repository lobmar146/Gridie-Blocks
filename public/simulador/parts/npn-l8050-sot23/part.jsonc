        "source": {
          "datasheet": {
            "doc": "Leshan Radio L8050QLT1G Rev.D Jun. 2023",
            "at": "THERMAL CHARACTERISTICS, total device dissipation 225 mW on an FR-5 board at TA = 25 C, RθJA 556 C/W. The alumina board is 300 mW, and this uses the lower of the two.",
            "basis": "max"
          }
        }
      }
    }
  },
  "not_simulated": [
    { "what": "beta roll-off", "why": "Beta does not fall at high or low current. hFE is specified at 100 mA, and the board uses this transistor at well under 1 mA." },
    { "what": "switching times", "why": "The capacitances are constant and there is no transit time, so a saturated switch has no storage time." },
    { "what": "breakdown", "why": "The junctions do not break down. VCEO (25 V), VCBO (40 V) and VEBO (5 V) are not checked." },
    { "what": "temperature", "why": "The fit is the 25 C traces. The sheet also draws 150 C traces, and the engine has no temperature." }
  ]
