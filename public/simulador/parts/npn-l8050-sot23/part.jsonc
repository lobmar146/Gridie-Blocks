      }
    },
    "reverse_beta": {
      "value": 27.75,
      "unit": "1",
      "source": {
        "datasheet": {
          "doc": "Leshan Radio L8050QLT1G Rev.D Jun. 2023",
          "at": "Page 4, VCE(sat) at 25 C and IC/IB = 10, read as 0.010 V at 1 mA, 0.019 V at 100 mA and 0.098 V at 0.8 A. Fitted by fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1, then solved again after RC was held at 0.01 ohm.",
          "basis": "typical"
        }
      }
    },
    "forward_emission": { "value": 1.0, "unit": "1", "source": { "closed_form": { "note": "ideal junction" } } },
