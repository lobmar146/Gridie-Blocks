    "early_voltage": {
      "value": 100.0,
      "unit": "V",
      "source": { "closed_form": { "note": "the sheet prints no Early voltage or output conductance, so this is 100 V" } }
    },
    "base_resistance": {
      "value": 4.337,
      "unit": "ohm",
      "source": {
        "datasheet": {
          "doc": "Leshan Radio L8050QLT1G Rev.D Jun. 2023",
          "at": "Page 4, VBE(sat) at 25 C and IC/IB = 10, read as 0.798 V at 100 mA and 0.940 V at 0.8 A. Fitted by fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1, then solved again after RC was held at 0.01 ohm.",
          "basis": "typical"
        }
      }
    },
    "collector_resistance": {
      "value": 0.01,
      "unit": "ohm",
      "source": {
        "datasheet": {
          "doc": "Leshan Radio L8050QLT1G Rev.D Jun. 2023",
          "at": "Page 4, VCE(sat) at 25 C and IC/IB = 10, read as 0.010 V at 1 mA, 0.019 V at 100 mA and 0.098 V at 0.8 A. fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1 returned RC of about -0.027 ohm, which the engine refuses, so RC is held at 0.01 ohm. With that floor the model is about 4 mV high at 100 mA (0.023 V against the 0.019 V reading).",
          "basis": "typical"
        }
      }
    },
    "emitter_resistance": {
      "value": 0.1068,
      "unit": "ohm",
      "source": {
        "datasheet": {
          "doc": "Leshan Radio L8050QLT1G Rev.D Jun. 2023",
          "at": "Page 3, VBE(on) at 25 C, read as 0.593 V at 1 mA, 0.653 V at 10 mA and 0.724 V at 100 mA. The table typical at VCE = 1 V and IC = 10 mA is 0.66 V. Fitted by fit() of packages/engine/scripts/fit_transistor.py with NF = NR = 1, then solved again after RC was held at 0.01 ohm.",
          "basis": "typical"
        }
      }
    },
