      }
    },
    "output_resistance": {
      "value": 0.006688963210702341,
      "unit": "ohm",
      "source": {
        "closed_form": {
          "note": "10 mV typical load regulation at TJ = 25 C, 5 mA ≤ IO ≤ 1.5 A, divided by 1.495 A. The maximum on that row is 50 mV. Section 6.6 of TI SNOSBT0L. The 8 mΩ output-resistance row is at 1 kHz, and this field is the DC slope."
        }
      }
    },
    "dropout_voltage": {
      "value": 1.999,
      "unit": "V",
      "source": {
        "closed_form": {
          "note": "2 V typical dropout at IO = 1 A and TJ = 25 C, minus 0.001 ohm times 1 A, so the drop is 2 V at that current. Section 6.6 of TI SNOSBT0L states that one current. Figure 11 defines the drop as the input-to-output gap when the output has fallen 100 mV, and at 25 C the 1 A curve sits near 2 V."
        }
      }
    },
    "dropout_resistance": {
      "value": 0.001,
      "unit": "ohm",
      "source": {
        "closed_form": {
          "note": "0.001 ohm, so the drop stays 2 V at 1 A and the resistance stays positive. The sheet states dropout at that one current. Figure 11 shows a smaller drop at a lighter current, and that slope was not read."
        }
      }
    },
    "current_limit": {
      "value": 2.4,
      "unit": "A",
      "source": {
        "datasheet": {
          "doc": "TI SNOSBT0L, LM340, LM340A, LM7805, LM7812, LM7815, February 2000, revised September 2016",
          "at": "Section 6.6, peak output current typical, 2.4 A, at TJ = 25 C. The short-circuit current on the row above is 2.1 A typical. Figure 10 shows the peak falling as the input-to-output gap grows.",
          "basis": "typical"
        }
      }
    },
    "quiescent_current": {
      "value": 0.0046,
      "unit": "A",
      "source": {
        "datasheet": {
          "doc": "TI SNOSBT0L, LM340, LM340A, LM7805, LM7812, LM7815, February 2000, revised September 2016",
          "at": "Figure 9, about 4.6 mA at TJ = 25 C, VIN = 10 V, VOUT = 5 V, IOUT = 5 mA. The section 6.6 quiescent-current row gives no typical, only a maximum of 8 mA at IO ≤ 1 A and TJ = 25 C.",
          "basis": "typical"
        }
      }
    },
    "ground_current_ratio": {
      "value": 0,
      "unit": "1",
      "source": {
        "closed_form": {
          "note": "The section 6.6 quiescent-current row has no 25 C load term, so the model holds the ground current at 4.6 mA while the input is up. The 0.5 mA typical change from 5 mA to 1 A is over 0 C to 125 C, not a 25 C slope."
        }
      }
    },
    "ratings": {
      "current": {
        "value": 1.5,
        "unit": "A",
        "basis": "peak",
        "source": {
          "datasheet": {
            "doc": "TI SNOSBT0L, LM340, LM340A, LM7805, LM7812, LM7815, February 2000, revised September 2016",
            "at": "Features, output current up to 1.5 A. The 25 C load-regulation row runs from 5 mA to 1.5 A. The part still regulates past this, up to the 2.4 A peak, and the rating warns.",
