      "input_bias_current": { "value": 2.0e-08, "unit": "A", "source": { "datasheet": { "doc": "TI SLOS068AB", "at": "p10 section 5.7, IB typical -20 nA into the pin at VO 1.4 V. The field is the current that leaves", "basis": "typical" } } },
      "swing_high": { "value": 1.21, "unit": "V", "source": { "closed_form": { "note": "p23 figure 5-46, section 5.12. The stroke center is 1.211 V below Vcc at 0.1 mA and 1.549 V below Vcc at 10 mA. The line through them falls 34.1 ohm and starts 1.208 V below Vcc, rounded to 1.21 V. The x-axis is printed Output Sink Current. The title is Output Sourcing Characteristics and the axis is the drop from Vcc, so the current is source current. The figure does not print a supply. Section 5.7's 5 V positive-rail row is a maximum of 1.5 V from V+ and has no typical" } } },
      "swing_low": { "value": 0.005, "unit": "V", "source": { "closed_form": { "note": "p10 section 5.7 VOL typical 5 mV from V- at VS 5 V, RL at most 10 kohm, returned to V-. One load, so the intercept is that typical. Figure 5-47's slope is not output_resistance" } } },
      "output_resistance": { "value": 30.0, "unit": "ohm", "source": { "closed_form": { "note": "the slope of the swing_high line, 338 mV over 9.9 mA, 34.1 ohm, rounded to 30. One resistance covers sourcing and sinking. Sinking into a load returned above V- is optimistic against p23 figure 5-47. Section 5.7's sink row at VO 200 mV is 30 uA typical and 12 uA minimum, so above about 30 uA the output leaves the bottom rail. Figure 5-47's 5 V curve goes vertical between 11 mA and 12 mA, while short_circuit_current lets the model sink 40 mA at 5 V. The model reads 12.5 mV into 10 kohm and 41.9 mV into 2 kohm, both returned to 2.5 V" } } },
      "short_circuit_current": { "value": 0.04, "unit": "A", "source": { "datasheet": { "doc": "TI SLOS068AB", "at": "p10 section 5.7, ISC +/-40 mA typical at VS 10 V, VO = VS / 2", "basis": "typical" } } },
      "supply_current": { "value": 0.00035, "unit": "A", "source": { "closed_form": { "note": "p10 section 5.7 IQ 350 uA typical per amplifier at VO 2.5 V and IO 0 A. The row is already one amplifier" } } },
      "input_headroom": { "value": 1.5, "unit": "V", "source": { "datasheet": { "doc": "TI SLOS068AB", "at": "p10 section 5.7, VCM MAX (V+) - 1.5 V for the LM358 at 25 C, VS 5 V to 30 V. Over 0 C to 70 C the same row is (V+) - 2 V", "basis": "max" } } },
