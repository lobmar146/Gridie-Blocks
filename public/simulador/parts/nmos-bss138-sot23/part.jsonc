        "basis": { "sustained": { "average": "mean", "tau": { "value": 0.0102, "unit": "s", "source": { "closed_form": { "note": "The sheet gives no pulse width for the dissipation, so this is the 10.2 ms default, five periods of a 490 Hz PWM." } } } } },
        "source": {
          "datasheet": {
