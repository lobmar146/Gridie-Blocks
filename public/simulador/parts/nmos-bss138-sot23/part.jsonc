  "model": {
    "kind": "nmos",
    "transconductance_parameter": {
      "value": 0.3236,
      "unit": "A/V^2",
      "source": {
        "datasheet": {
          "doc": "onsemi BSS138/D, Rev. 7, April 2024",
          "at": "On Characteristics, RDS(on) typical 1.0 ohm at VGS = 4.5 V, ID = 0.22 A. vds is 0.22 V there. With VTO = 1.3 V, KP = 1 / (1.0 * (3.2 - 0.11)) rounds to 0.3236 A/V^2 and gives 1.000 ohm at that point. At VGS = 10 V and ID = 0.22 A the model gives about 0.357 ohm, where the table's typical is 0.7 ohm. In saturation at 0.22 A the model's gm is about 0.377 S, where gFS typical is 0.5 S",
          "basis": "typical",
        },
      },
    },
    "threshold_voltage": {
      "value": 1.3,
      "unit": "V",
      "source": {
        "datasheet": {
          "doc": "onsemi BSS138/D, Rev. 7, April 2024",
          "at": "On Characteristics, VGS(th) typical 1.3 V at VDS = VGS, ID = 1 mA. The table's range is 0.8 V to 1.5 V",
          "basis": "typical",
        },
      },
    },
    "channel_length_modulation": {
      "value": 0.0,
      "unit": "1/V",
      "source": {
        "datasheet": {
          "doc": "onsemi BSS138/D, Rev. 7, April 2024",
          "at": "Not fitted. The on-resistance point is at vds = 0.22 V, in the linear region, so the output-curve slope was not read",
          "basis": "typical",
        },
      },
    },
    "gate_source_capacitance": {
      "value": 2.1e-11,
      "unit": "F",
      "source": {
