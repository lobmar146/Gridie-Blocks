  "not_simulated": [
    {
      "what": "where a real coil pulls in",
      "why": "The sheet's pull-in is a maximum: the relay must have operated by 75% of nominal, and it may operate sooner. Drop-out is a minimum: it must still be open at 10%, and it may release higher. This model switches at those two bounds."
    },
    {
      "what": "armature travel and bounce",
      "why": "The contact moves when the coil current crosses a threshold. The sheet's 10 ms and 5 ms include the armature. The 70 mH coil puts both crossings inside those times, and there is no separate travel and no bounce."
    },
    {
      "what": "contact current and voltage",
      "why": "The engine watches the coil. A contact past 7 A or 28 V DC is not a warning. The contacts still open and close."
    },
    {
      "what": "the ±10% coil resistance and temperature",
      "why": "Every coil is the 70 ohm nominal at 20 C."
    }
  ]
